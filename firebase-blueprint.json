{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile information of a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string", "maxLength": 50 },
        "fullName": { "type": "string", "maxLength": 100 },
        "avatar": { "type": "string", "maxLength": 1000 },
        "bio": { "type": "string", "maxLength": 500 },
        "website": { "type": "string", "maxLength": 200 },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "postsCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "username", "fullName"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private profile information including email",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public user profile document"
    },
    "/users/{userId}/private/info": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Private sensitive user info such as email"
    }
  }
}
