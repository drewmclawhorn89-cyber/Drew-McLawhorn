rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'username', 'fullName'])
        && data.id is string && data.id.size() <= 128
        && data.username is string && data.username.size() > 0 && data.username.size() <= 50
        && data.fullName is string && data.fullName.size() <= 100
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 1000))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
        && (!('website' in data) || (data.website is string && data.website.size() <= 200))
        && (!('followersCount' in data) || data.followersCount is number)
        && (!('followingCount' in data) || data.followingCount is number)
        && (!('postsCount' in data) || data.postsCount is number);
    }

    // Public user profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().id == userId;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().id == existing().id;
      allow delete: if isOwner(userId);

      // Private user information subcollection
      match /private/{document} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
